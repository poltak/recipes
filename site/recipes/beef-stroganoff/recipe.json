{
  "$schema": "../recipe.schema.json",
  "title": "Beef Stroganoff",
  "description": "Seared beef tenderloin in a mushroom, cognac, and sour cream sauce.",
  "yield": "4 servings",
  "time": { "prep": "20 min", "cook": "35 min" },
  "tags": ["beef", "dinner"],
  "source": { "name": "Cooking For Engineers", "url": "https://www.cookingforengineers.com/recipe/122/Beef-Stroganoff" },
  "ingredients": [
    { "id": "beef", "amount": "1-1/2 lb.", "metric": "700 g", "name": "beef tenderloin" },
    { "id": "butter-beef", "amount": "1 Tbs.", "metric": "15 g", "name": "butter", "note": "for the beef" },
    { "id": "butter-onion", "amount": "1 Tbs.", "metric": "15 g", "name": "butter", "note": "for the onion" },
    { "id": "onion", "amount": "1/2 medium", "metric": "60 g", "name": "onion" },
    { "id": "mushrooms", "amount": "8 oz.", "metric": "225 g", "name": "button mushrooms" },
    { "id": "broth", "amount": "3/4 cup", "metric": "180 mL", "name": "beef broth" },
    { "id": "cognac", "amount": "2 Tbs.", "metric": "30 mL", "name": "cognac" },
    { "id": "sour-cream", "amount": "1 cup", "metric": "230 g", "name": "sour cream" },
    { "id": "mustard", "amount": "1 Tbs.", "metric": "15 g", "name": "Dijon mustard" },
    { "id": "dill", "amount": "1 tsp.", "metric": "1 g", "name": "dried dill weed" },
    { "id": "seasoning", "name": "salt & pepper" }
  ],
  "steps": [
    {
      "id": "strips",
      "action": "cut into thin 1 x 2-in. (2.5 x 5-cm) strips",
      "inputs": ["beef"],
      "text": "Cut the beef into thin strips, about 1 by 2 inches (2.5 by 5 cm)."
    },
    {
      "id": "browned",
      "action": "brown",
      "inputs": ["strips", "butter-beef"],
      "text": "Melt the butter in a large pan over high heat. Brown the beef in small batches, so it sears and does not steam. Put the beef on a plate."
    },
    { "id": "diced", "action": "fine dice", "inputs": ["onion"], "text": "Dice the onion finely." },
    { "id": "sliced", "action": "slice thickly", "inputs": ["mushrooms"], "text": "Cut the mushrooms into thick slices." },
    {
      "id": "soft-onion",
      "action": "cook until translucent",
      "inputs": ["butter-onion", "diced"],
      "text": "Turn the heat to medium. Melt the butter in the same pan and cook the onion until it is translucent. Scrape up the brown bits from the beef."
    },
    {
      "id": "mushroom-mix",
      "action": "cook until liquid evaporates, 15 min.",
      "inputs": ["soft-onion", "sliced"],
      "text": "Add the mushrooms. Cook for about 15 minutes, until their liquid evaporates."
    },
    {
      "id": "sauce",
      "action": "reduce until sauce coats mushrooms",
      "inputs": ["mushroom-mix", "broth", "cognac"],
      "text": "Add the broth and cognac. Boil until the sauce is thick enough to coat the mushrooms."
    },
    {
      "id": "creamy",
      "action": "stir in",
      "inputs": ["sauce", "sour-cream", "mustard"],
      "text": "Turn the heat to low. Stir in the sour cream and mustard. Do not let the sauce boil, or the sour cream can split."
    },
    {
      "id": "together",
      "action": "simmer until beef is hot",
      "inputs": ["browned", "creamy"],
      "text": "Put the beef and its juices back in the pan. Simmer gently until the beef is hot."
    },
    {
      "action": "add dill and season to taste",
      "inputs": ["together", "dill", "seasoning"],
      "text": "Stir in the dill. Add salt and pepper to taste. Serve on egg noodles or rice."
    }
  ]
}
