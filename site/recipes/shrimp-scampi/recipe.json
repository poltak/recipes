{
  "$schema": "../recipe.schema.json",
  "title": "Shrimp Scampi",
  "description": "Shrimp in garlic butter, ready in ten minutes.",
  "yield": "2 servings",
  "time": { "prep": "10 min", "cook": "6 min" },
  "tags": ["seafood", "dinner", "quick"],
  "source": { "name": "Cooking For Engineers", "url": "https://www.cookingforengineers.com/recipe/15/Shrimp-Scampi" },
  "ingredients": [
    { "id": "shrimp", "amount": "1 lb.", "metric": "450 g", "name": "shrimp", "note": "peeled and deveined" },
    { "id": "butter", "amount": "4 Tbs.", "metric": "55 g", "name": "butter" },
    { "id": "oil", "amount": "2 Tbs.", "metric": "30 mL", "name": "olive oil" },
    { "id": "salt", "amount": "1/4 tsp.", "metric": "1.5 g", "name": "salt" },
    { "id": "garlic", "amount": "2 tsp.", "metric": "6 g", "name": "minced garlic" },
    { "id": "parsley", "amount": "1 Tbs.", "metric": "4 g", "name": "chopped parsley" }
  ],
  "steps": [
    {
      "id": "fat",
      "action": "melt",
      "inputs": ["butter", "oil"],
      "text": "Melt the butter with the olive oil in a large pan over medium heat."
    },
    {
      "id": "garlic-butter",
      "action": "brown",
      "inputs": ["fat", "salt", "garlic"],
      "text": "Add the salt and garlic. Cook for about 1 minute, until the garlic just starts to turn gold."
    },
    {
      "id": "first-side",
      "action": "cook until opaque",
      "inputs": ["shrimp", "garlic-butter"],
      "text": "Put the shrimp in the pan in one layer. Cook for about 2 minutes, until the bottoms are opaque."
    },
    {
      "id": "cooked",
      "action": "flip; cook until opaque",
      "inputs": ["first-side"],
      "text": "Turn each shrimp over. Cook for 1 to 2 minutes more, until the shrimp are opaque all the way through."
    },
    {
      "action": "add",
      "inputs": ["cooked", "parsley"],
      "text": "Take the pan off the heat, stir in the parsley, and serve at once."
    }
  ]
}
