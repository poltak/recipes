{
  "$schema": "../recipe.schema.json",
  "title": "Pressure Cooker Beef Stew",
  "description": "A rich, savoury pressure-cooker beef stew with potatoes, carrots, onion, garlic and Vietnamese-style seasoning. Choose the tomato version or the no-tomato version.",
  "yield": "4 servings",
  "time": { "prep": "15 min", "cook": "25 min at pressure" },
  "tags": ["beef", "stew", "pressure-cooker", "dinner", "vietnam"],
  "choices": [
    {
      "id": "version",
      "label": "Version",
      "options": [
        {
          "id": "tomato",
          "label": "tomato",
          "note": "The original version with tomatoes and a larger 500–600 g beef batch."
        },
        {
          "id": "no-tomato",
          "label": "no tomato",
          "note": "The later 430 g beef batch; uses less water and a little vinegar or lime juice for acidity."
        }
      ]
    }
  ],
  "ingredients": [
    { "id": "oil-tomato", "amount": "1 tbsp", "name": "cooking oil", "when": { "version": "tomato" } },
    { "id": "oil-no", "amount": "2-1/2 tsp", "name": "cooking oil", "when": { "version": "no-tomato" } },
    { "id": "onion-tomato", "amount": "150 g", "name": "onion", "note": "chopped", "when": { "version": "tomato" } },
    { "id": "onion-no", "amount": "120 g", "name": "onion", "note": "chopped", "when": { "version": "no-tomato" } },
    {
      "id": "garlic-tomato",
      "amount": "15–20 g",
      "name": "garlic",
      "note": "chopped",
      "when": { "version": "tomato" }
    },
    { "id": "garlic-no", "amount": "12–15 g", "name": "garlic", "note": "chopped", "when": { "version": "no-tomato" } },
    {
      "id": "beef-tomato",
      "amount": "500–600 g",
      "name": "beef",
      "note": "cut into large chunks; nạm bò or bắp bò work well",
      "when": { "version": "tomato" }
    },
    {
      "id": "beef-no",
      "amount": "430 g",
      "name": "beef",
      "note": "cut into large chunks",
      "when": { "version": "no-tomato" }
    },
    {
      "id": "tomatoes",
      "amount": "214 g",
      "name": "tomatoes",
      "note": "roughly chopped",
      "when": { "version": "tomato" }
    },
    { "id": "fish-tomato", "amount": "2 tbsp", "name": "fish sauce", "when": { "version": "tomato" } },
    { "id": "fish-no", "amount": "1-1/2 tbsp", "name": "fish sauce", "when": { "version": "no-tomato" } },
    { "id": "soy-tomato", "amount": "1 tbsp", "name": "soy sauce", "when": { "version": "tomato" } },
    { "id": "soy-no", "amount": "2-1/2 tsp", "name": "soy sauce", "when": { "version": "no-tomato" } },
    { "id": "stock-tomato", "amount": "2 tsp", "name": "stock powder (hạt nêm)", "when": { "version": "tomato" } },
    { "id": "stock-no", "amount": "1-1/2 tsp", "name": "stock powder (hạt nêm)", "when": { "version": "no-tomato" } },
    { "id": "msg-tomato", "amount": "1/4 tsp", "name": "MSG", "when": { "version": "tomato" } },
    { "id": "msg-no", "amount": "scant 1/4 tsp", "name": "MSG", "when": { "version": "no-tomato" } },
    { "id": "sugar-tomato", "amount": "1 tsp", "name": "sugar", "when": { "version": "tomato" } },
    { "id": "sugar-no", "amount": "3/4 tsp", "name": "sugar", "when": { "version": "no-tomato" } },
    { "id": "pepper", "name": "black pepper", "note": "to taste" },
    { "id": "water-tomato", "amount": "350–400 ml", "name": "water", "when": { "version": "tomato" } },
    { "id": "water-no", "amount": "300 ml", "name": "water", "when": { "version": "no-tomato" } },
    {
      "id": "potatoes-tomato",
      "amount": "450–500 g",
      "name": "potatoes",
      "note": "large chunks",
      "when": { "version": "tomato" }
    },
    {
      "id": "potatoes-no",
      "amount": "375 g",
      "name": "potatoes",
      "note": "large chunks",
      "when": { "version": "no-tomato" }
    },
    {
      "id": "carrots-tomato",
      "amount": "170 g",
      "name": "carrots",
      "note": "large chunks",
      "when": { "version": "tomato" }
    },
    {
      "id": "carrots-no",
      "amount": "130 g",
      "name": "carrots",
      "note": "large chunks",
      "when": { "version": "no-tomato" }
    },
    {
      "id": "acid-no",
      "amount": "1 tsp",
      "name": "vinegar or lime juice",
      "note": "add at the end, to taste",
      "when": { "version": "no-tomato" }
    },
    {
      "id": "fish-finish-tomato",
      "amount": "1 tsp",
      "name": "fish sauce",
      "note": "optional, to adjust seasoning after cooking",
      "when": { "version": "tomato" }
    },
    {
      "id": "fish-finish-no",
      "amount": "1 tsp",
      "name": "fish sauce",
      "note": "optional, to adjust seasoning after cooking",
      "when": { "version": "no-tomato" }
    }
  ],
  "steps": [
    {
      "id": "saute",
      "action": "Sauté onion and garlic",
      "inputs": ["oil-tomato", "oil-no", "onion-tomato", "onion-no", "garlic-tomato", "garlic-no"],
      "text": "Heat the oil in the open pressure cooker. Sauté the onion for about 1–2 minutes until it starts to soften; add the garlic for the last 30–60 seconds, avoiding burning it."
    },
    {
      "id": "brown",
      "action": "Brown beef 6–8 min",
      "inputs": ["saute", "beef-tomato", "beef-no"],
      "text": "Add the beef and brown for 6–8 minutes, turning occasionally to develop colour."
    },
    {
      "id": "base",
      "action": "Build stew base",
      "inputs": ["brown", "tomatoes"],
      "text": "For the tomato version, add the tomatoes and cook for 3–5 minutes until soft and starting to break down. For the no-tomato version, skip this and continue straight to seasoning."
    },
    {
      "id": "seasoned",
      "action": "Add seasonings and water",
      "inputs": [
        "base",
        "fish-tomato",
        "fish-no",
        "soy-tomato",
        "soy-no",
        "stock-tomato",
        "stock-no",
        "msg-tomato",
        "msg-no",
        "sugar-tomato",
        "sugar-no",
        "pepper",
        "water-tomato",
        "water-no"
      ],
      "text": "Add fish sauce, soy sauce, stock powder, MSG, sugar, black pepper and water. Stir and scrape any browned bits off the base."
    },
    {
      "id": "loaded",
      "action": "Add potatoes and carrots",
      "inputs": ["seasoned", "potatoes-tomato", "potatoes-no", "carrots-tomato", "carrots-no"],
      "text": "Place the potatoes and carrots on top. Close and lock the pressure cooker lid."
    },
    {
      "id": "cooked",
      "action": "Pressure cook 25 min",
      "inputs": ["loaded"],
      "text": "Use about 2000 W to reach full pressure. Reduce to the lowest setting that keeps full pressure, often around 600–800 W with gentle regulator movement. Start the 25-minute timer once full pressure is reached."
    },
    {
      "id": "rested",
      "action": "Natural release 10 min",
      "inputs": ["cooked"],
      "text": "Turn the heat off. Let the cooker depressurize naturally for 10 minutes, then carefully release any remaining pressure according to its instructions before opening."
    },
    {
      "action": "Taste and serve",
      "inputs": ["rested", "fish-finish-tomato", "fish-finish-no", "acid-no"],
      "text": "Stir and taste. Add up to 1 tsp extra fish sauce if needed. For the no-tomato version, add about 1 tsp vinegar or lime juice for acidity. Serve with rice or bread."
    }
  ],
  "notes": [
    "Nutrition is estimated from standard ingredient data and the midpoint of ingredient ranges. Finished weight is estimated after pressure cooking, so per-100-g values are approximate.",
    "Chunky vegetables cooked for 25 minutes will be soft. For firmer potatoes and carrots, pressure cook the beef first, then add vegetables and pressure cook about 4 more minutes.",
    "Watt settings vary by cooker; maintain pressure based on your cooker’s regulator and instructions rather than relying on a fixed watt number."
  ],
  "nutrition": [
    {
      "per": "100 g",
      "kcal": 96,
      "protein": 6.4,
      "fat": 4.9,
      "carbs": 7.1,
      "sugar": 1.6,
      "fiber": 1.1,
      "when": { "version": "tomato" }
    },
    {
      "per": "1 serving",
      "kcal": 462,
      "protein": 31.1,
      "fat": 23.5,
      "carbs": 34,
      "sugar": 7.5,
      "fiber": 5.2,
      "when": { "version": "tomato" }
    },
    {
      "per": "100 g",
      "kcal": 104,
      "protein": 7,
      "fat": 5.4,
      "carbs": 7.3,
      "sugar": 1.4,
      "fiber": 1,
      "when": { "version": "no-tomato" }
    },
    {
      "per": "1 serving",
      "kcal": 356,
      "protein": 23.9,
      "fat": 18.5,
      "carbs": 25.1,
      "sugar": 4.8,
      "fiber": 3.6,
      "when": { "version": "no-tomato" }
    }
  ]
}
